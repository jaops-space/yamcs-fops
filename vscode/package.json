{
  "name": "fops-vscode",
  "displayName": "fops",
  "description": "Writing flight operations procedures for Yamcs: live fops check, MDB completion, hovers and the procedure outline",
  "version": "0.1.0",
  "publisher": "jaops",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#141414",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "yamcs",
    "procedures",
    "flight operations",
    "mission control",
    "spacecraft",
    "ECSS"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:python",
    "workspaceContains:**/mdb/__init__.py"
  ],
  "contributes": {
    "configuration": {
      "title": "fops",
      "properties": {
        "fops.executable": {
          "type": "string",
          "default": "",
          "markdownDescription": "The `fops` binary. Empty: `target/release/fops` in a workspace folder, else `fops` on the `PATH`."
        },
        "fops.mdbPackage": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory of the package generated by `fops mdb-gen` (e.g. `procedures/mdb`). Empty: found in the workspace."
        },
        "fops.yamcs.url": {
          "type": "string",
          "default": "http://localhost:8090",
          "description": "Yamcs URL, for Run procedure and Regenerate MDB."
        },
        "fops.yamcs.instance": {
          "type": "string",
          "default": "",
          "markdownDescription": "Yamcs instance. Empty: the instance the MDB package was generated from."
        },
        "fops.check.onType": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run `fops check` on unsaved changes (a copy is checked; the file is not written). Otherwise only on open and save."
        },
        "fops.check.delay": {
          "type": "number",
          "default": 500,
          "description": "Milliseconds after the last change before checking."
        },
        "fops.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show step numbers and conditions above steps and watches."
        },
        "fops.completion.autoImport": {
          "type": "boolean",
          "default": true,
          "description": "Complete MDB parameters and commands that are not imported yet, adding the import."
        }
      }
    },
    "commands": [
      {
        "command": "fops.checkFile",
        "title": "Check This Procedure",
        "category": "fops"
      },
      {
        "command": "fops.checkAll",
        "title": "Check All Procedures",
        "category": "fops"
      },
      {
        "command": "fops.insertItem",
        "title": "Insert MDB Parameter or Command\u2026",
        "category": "fops"
      },
      {
        "command": "fops.runProcedure",
        "title": "Run Procedure in Terminal",
        "category": "fops",
        "icon": "$(play)"
      },
      {
        "command": "fops.mdbGen",
        "title": "Regenerate MDB Package from Yamcs",
        "category": "fops"
      },
      {
        "command": "fops.configurePython",
        "title": "Configure Python Analysis Paths",
        "category": "fops"
      },
      {
        "command": "fops.refresh",
        "title": "Refresh",
        "category": "fops",
        "icon": "$(refresh)"
      },
      {
        "command": "fops.mdbView.insert",
        "title": "Insert at Cursor",
        "category": "fops",
        "icon": "$(insert)"
      },
      {
        "command": "fops.mdbView.copyName",
        "title": "Copy Qualified Name",
        "category": "fops"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "fops.procedure",
          "name": "FOP Procedure",
          "when": "fops.active"
        },
        {
          "id": "fops.mdb",
          "name": "FOP MDB",
          "when": "fops.active"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "fops.runProcedure",
          "when": "view == fops.procedure",
          "group": "navigation"
        },
        {
          "command": "fops.refresh",
          "when": "view == fops.procedure || view == fops.mdb",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "fops.mdbView.insert",
          "when": "view == fops.mdb && viewItem =~ /^(param|command)$/",
          "group": "inline"
        },
        {
          "command": "fops.mdbView.insert",
          "when": "view == fops.mdb && viewItem =~ /^(param|command)$/",
          "group": "1"
        },
        {
          "command": "fops.mdbView.copyName",
          "when": "view == fops.mdb && viewItem =~ /^(param|command)$/",
          "group": "1"
        }
      ],
      "commandPalette": [
        {
          "command": "fops.mdbView.insert",
          "when": "false"
        },
        {
          "command": "fops.mdbView.copyName",
          "when": "false"
        },
        {
          "command": "fops.refresh",
          "when": "false"
        }
      ],
      "editor/title/run": [
        {
          "command": "fops.runProcedure",
          "when": "fops.isProcedure",
          "group": "navigation"
        }
      ]
    },
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/fops.json"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node out/test/run.js",
    "package": "vsce package --allow-missing-repository",
    "test:vscode": "scripts/integration.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
